{
  "name": "deskseed-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "workspaces": [
    "apps/customer-portal",
    "apps/staff-console"
  ],
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26.0.0"
  },
  "scripts": {
    "dev": "node scripts/dev-isolated-apps.mjs",
    "dev:customer": "vite --config apps/customer-portal/vite.config.ts",
    "dev:staff": "vite --config apps/staff-console/vite.config.ts",
    "build": "tsc -b && npm run build:customer && npm run build:staff",
    "build:customer": "vite build --config apps/customer-portal/vite.config.ts",
    "build:staff": "vite build --config apps/staff-console/vite.config.ts",
    "preview:customer": "vite preview --config apps/customer-portal/vite.config.ts",
    "preview:staff": "vite preview --config apps/staff-console/vite.config.ts",
    "typecheck": "tsc -b --pretty false",
    "lint": "eslint .",
    "format:check": "prettier --check .",
    "format": "prettier --write .",
    "contract:check": "node scripts/check-p1-openapi-contract.mjs",
    "check:design-system-boundaries": "node --test scripts/check-design-system-boundaries.test.mjs && node scripts/check-design-system-boundaries.mjs",
    "test": "npm run test:customer && npm run test:staff",
    "test:customer": "vitest run --config apps/customer-portal/vite.config.ts --project unit",
    "test:staff": "vitest run --config apps/staff-console/vite.config.ts --project unit",
    "test:storybook": "npm run test:storybook:customer && npm run test:storybook:staff",
    "test:storybook:customer": "vitest run --config apps/customer-portal/vite.config.ts --project storybook",
    "test:storybook:staff": "vitest run --config apps/staff-console/vite.config.ts --project storybook",
    "test:e2e": "playwright test",
    "test:e2e:dev": "playwright test access-surface.spec.ts admin-operations.spec.ts agent-views-workspace.spec.ts agent-ticket-write.spec.ts frontend-system.spec.ts ticket-workspace.spec.ts",
    "test:e2e:update": "playwright test access-surface.spec.ts admin-operations.spec.ts agent-views-workspace.spec.ts agent-ticket-write.spec.ts frontend-system.spec.ts ticket-workspace.spec.ts --update-snapshots=all",
    "storybook": "npm run storybook:staff",
    "storybook:customer": "storybook dev -p 6007 -c apps/customer-portal/.storybook",
    "storybook:staff": "storybook dev -p 6006 -c apps/staff-console/.storybook",
    "build-storybook": "npm run build-storybook:customer && npm run build-storybook:staff",
    "build-storybook:customer": "storybook build -c apps/customer-portal/.storybook -o storybook-static/customer",
    "build-storybook:staff": "storybook build -c apps/staff-console/.storybook -o storybook-static/staff"
  },
  "dependencies": {
    "@tanstack/react-query": "5.101.4",
    "@tiptap/core": "3.30.5",
    "@tiptap/extension-link": "3.30.5",
    "@tiptap/extension-text-align": "3.30.5",
    "@tiptap/extension-underline": "3.30.5",
    "@tiptap/pm": "3.30.5",
    "@tiptap/react": "3.30.5",
    "@tiptap/starter-kit": "3.30.5",
    "@zendeskgarden/react-buttons": "9.15.7",
    "@zendeskgarden/react-dropdowns": "9.15.7",
    "@zendeskgarden/react-theming": "9.15.7",
    "@zendeskgarden/svg-icons": "7.6.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-router": "7.18.2",
    "styled-components": "6.5.2"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@chromatic-com/storybook": "latest",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.62.1",
    "@storybook/addon-a11y": "^10.5.7",
    "@storybook/addon-docs": "^10.5.10",
    "@storybook/addon-mcp": "0.7.0",
    "@storybook/addon-vitest": "^10.5.8",
    "@storybook/react-vite": "^10.5.7",
    "@testing-library/jest-dom": "7.0.0",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.5",
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "@vitejs/plugin-react": "6.0.5",
    "@vitest/browser-playwright": "4.1.10",
    "@vitest/coverage-v8": "4.1.10",
    "eslint": "10.8.1",
    "eslint-plugin-storybook": "^10.5.7",
    "globals": "17.9.0",
    "jsdom": "30.0.1",
    "mockdate": "3.0.5",
    "msw": "2.15.0",
    "msw-storybook-addon": "3.0.0",
    "playwright": "latest",
    "prettier": "3.9.6",
    "storybook": "^10.5.8",
    "typescript": "5.9.3",
    "typescript-eslint": "8.57.0",
    "vite": "8.2.1",
    "vitest": "4.1.10"
  },
  "msw": {
    "workerDirectory": [
      "apps/customer-portal/public",
      "apps/staff-console/public"
    ]
  },
  "overrides": {
    "valibot": "1.4.2"
  }
}
