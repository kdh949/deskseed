{
  "name": "deskseed-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --pretty false",
    "lint": "eslint .",
    "format:check": "prettier --check .",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:e2e:dev": "playwright test agent-views-workspace.spec.ts audit-explorer.spec.ts customer-request.spec.ts frontend-system.spec.ts staff-auth-admin.spec.ts ticket-composer-conflict.spec.ts transfer-child-ticket.spec.ts",
    "test:e2e:update": "playwright test --update-snapshots",
    "test:e2e:stack": "bash ../scripts/run-customer-request-e2e.sh",
    "test:e2e:audit-stack": "bash ../scripts/run-audit-explorer-e2e.sh"
  },
  "dependencies": {
    "@tanstack/react-query": "5.101.4",
    "@zendeskgarden/react-buttons": "9.15.7",
    "@zendeskgarden/react-theming": "9.15.7",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-router": "7.9.6",
    "styled-components": "6.1.19"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.12.1",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.62.1",
    "@testing-library/jest-dom": "7.0.0",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.3",
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "@vitejs/plugin-react": "6.0.5",
    "eslint": "10.8.1",
    "globals": "17.9.0",
    "jsdom": "28.1.0",
    "prettier": "3.9.6",
    "typescript": "5.9.3",
    "typescript-eslint": "8.57.0",
    "vite": "8.2.1",
    "vitest": "4.1.10"
  }
}
