{
  "name": "deskseed-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26.0.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --pretty false",
    "lint": "eslint .",
    "format:check": "prettier --check .",
    "format": "prettier --write .",
    "contract:check": "node scripts/check-p1-openapi-contract.mjs",
    "check:design-system-boundaries": "node scripts/check-design-system-boundaries.mjs",
    "test": "vitest run --project unit",
    "test:storybook": "vitest run --project storybook",
    "test:e2e": "playwright test",
    "test:e2e:dev": "playwright test access-surface.spec.ts admin-operations.spec.ts agent-views-workspace.spec.ts agent-ticket-write.spec.ts frontend-system.spec.ts ticket-workspace.spec.ts",
    "test:e2e:update": "playwright test access-surface.spec.ts admin-operations.spec.ts agent-views-workspace.spec.ts agent-ticket-write.spec.ts frontend-system.spec.ts ticket-workspace.spec.ts --update-snapshots=all",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build"
  },
  "dependencies": {
    "@tanstack/react-query": "5.101.4",
    "@zendeskgarden/react-buttons": "9.15.7",
    "@zendeskgarden/react-theming": "9.15.7",
    "@zendeskgarden/svg-icons": "7.6.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-router": "7.18.2",
    "styled-components": "6.5.2"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@chromatic-com/storybook": "latest",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.62.1",
    "@storybook/addon-a11y": "^10.5.7",
    "@storybook/addon-docs": "^10.5.10",
    "@storybook/addon-mcp": "0.7.0",
    "@storybook/addon-vitest": "^10.5.8",
    "@storybook/react-vite": "^10.5.10",
    "@testing-library/jest-dom": "7.0.0",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.5",
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "@vitejs/plugin-react": "6.0.5",
    "@vitest/browser-playwright": "4.1.10",
    "@vitest/coverage-v8": "4.1.10",
    "eslint": "10.8.1",
    "eslint-plugin-storybook": "^10.5.7",
    "globals": "17.9.0",
    "jsdom": "30.0.1",
    "mockdate": "3.0.5",
    "msw": "2.15.0",
    "msw-storybook-addon": "3.0.0",
    "playwright": "latest",
    "prettier": "3.9.6",
    "storybook": "^10.5.8",
    "typescript": "5.9.3",
    "typescript-eslint": "8.57.0",
    "vite": "8.2.1",
    "vitest": "4.1.10"
  },
  "msw": {
    "workerDirectory": [
      "public"
    ]
  },
  "overrides": {
    "valibot": "1.4.2"
  }
}
