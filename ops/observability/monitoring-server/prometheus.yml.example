global:
  scrape_interval: 15s
  evaluation_interval: 15s

rule_files:
  - /etc/prometheus/deskseed-load.rules.yml

scrape_configs:
  - job_name: deskseed-backend
    metrics_path: /actuator/prometheus
    relabel_configs:
      - source_labels: [__address__]
        regex: "(.*):[0-9]+"
        target_label: host
        replacement: "$1"
    static_configs:
      - targets: ["deskseed-load.internal:9090"]
        labels:
          environment: load
          service: deskseed-backend
          stack: deskseed

  - job_name: deskseed-node
    relabel_configs:
      - source_labels: [__address__]
        regex: "(.*):[0-9]+"
        target_label: host
        replacement: "$1"
    static_configs:
      - targets: ["deskseed-load.internal:9100"]
        labels:
          environment: load
          service: deskseed-node
          stack: deskseed

  - job_name: deskseed-containers
    relabel_configs:
      - source_labels: [__address__]
        regex: "(.*):[0-9]+"
        target_label: host
        replacement: "$1"
    static_configs:
      - targets: ["deskseed-load.internal:8081"]
        labels:
          environment: load
          service: deskseed-containers
          stack: deskseed

  - job_name: deskseed-postgresql
    relabel_configs:
      - source_labels: [__address__]
        regex: "(.*):[0-9]+"
        target_label: host
        replacement: "$1"
    static_configs:
      - targets: ["deskseed-load.internal:9187"]
        labels:
          environment: load
          service: deskseed-postgresql
          stack: deskseed

  - job_name: deskseed-nginx
    relabel_configs:
      - source_labels: [__address__]
        regex: "(.*):[0-9]+"
        target_label: host
        replacement: "$1"
    static_configs:
      - targets: ["deskseed-load.internal:9113"]
        labels:
          environment: load
          service: deskseed-nginx
          stack: deskseed

  - job_name: deskseed-redis
    relabel_configs:
      - source_labels: [__address__]
        regex: "(.*):[0-9]+"
        target_label: host
        replacement: "$1"
    static_configs:
      - targets: ["deskseed-load.internal:9121"]
        labels:
          environment: load
          service: deskseed-redis
          stack: deskseed

  - job_name: deskseed-alloy
    relabel_configs:
      - source_labels: [__address__]
        regex: "(.*):[0-9]+"
        target_label: host
        replacement: "$1"
    static_configs:
      - targets: ["deskseed-load.internal:12345"]
        labels:
          environment: load
          service: deskseed-alloy
          stack: deskseed
