global:
  scrape_interval: 15s
  evaluation_interval: 15s

rule_files:
  - /etc/prometheus/deskseed-load.rules.yml

scrape_configs:
  - job_name: deskseed-backend
    metrics_path: /actuator/prometheus
    static_configs:
      - targets: ["deskseed-load.internal:9090"]
        labels:
          environment: load
          service: deskseed-backend
          stack: deskseed

  - job_name: deskseed-node
    static_configs:
      - targets: ["deskseed-load.internal:9100"]
        labels:
          environment: load
          service: deskseed-node
          stack: deskseed

  - job_name: deskseed-containers
    static_configs:
      - targets: ["deskseed-load.internal:8081"]
        labels:
          environment: load
          service: deskseed-containers
          stack: deskseed

  - job_name: deskseed-postgresql
    static_configs:
      - targets: ["deskseed-load.internal:9187"]
        labels:
          environment: load
          service: deskseed-postgresql
          stack: deskseed

  - job_name: deskseed-redis
    static_configs:
      - targets: ["deskseed-load.internal:9121"]
        labels:
          environment: load
          service: deskseed-redis
          stack: deskseed

  - job_name: deskseed-alloy
    static_configs:
      - targets: ["deskseed-load.internal:12345"]
        labels:
          environment: load
          service: deskseed-alloy
          stack: deskseed
