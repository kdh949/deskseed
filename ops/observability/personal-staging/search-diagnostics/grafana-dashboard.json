{
  "id": null,
  "uid": "deskseed-search-diagnostics",
  "title": "Deskseed Performance RCA",
  "tags": [
    "deskseed",
    "personal-staging",
    "search"
  ],
  "schemaVersion": 39,
  "version": 6,
  "editable": true,
  "timezone": "browser",
  "time": {
    "from": "now-30m",
    "to": "now"
  },
  "refresh": "15s",
  "templating": {
    "list": [
      {
        "name": "environment",
        "type": "custom",
        "query": "personal-staging,load",
        "current": {
          "text": "personal-staging",
          "value": "personal-staging"
        },
        "hide": 0,
        "label": "Environment",
        "options": [
          {
            "selected": true,
            "text": "personal-staging",
            "value": "personal-staging"
          },
          {
            "selected": false,
            "text": "load",
            "value": "load"
          }
        ]
      },
      {
        "name": "run",
        "label": "Test run",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": "label_values(k6_agent_search_requests_total{environment=\"$environment\"},test_run_id)",
        "refresh": 2,
        "includeAll": true,
        "allValue": ".*",
        "current": {
          "text": "All",
          "value": "$__all"
        }
      },
      {
        "name": "plan_artifact_base",
        "label": "Protected plan artifact index",
        "type": "textbox",
        "query": "/search-plan-artifacts/index.html",
        "current": {
          "text": "/search-plan-artifacts/index.html",
          "value": "/search-plan-artifacts/index.html"
        }
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "title": "Required scrape targets",
      "type": "timeseries",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "up{environment=\"$environment\",stack=\"deskseed\",service=~\"deskseed-backend|deskseed-alloy|deskseed-postgresql|deskseed-node\"}",
          "legendFormat": "{{service}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "No data — unavailable or no matching samples",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green"
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "description": "All four must be 1 in the selected interval; absence is a failed readiness check. No data means telemetry is unavailable or no matching samples exist; it is not measured zero or a healthy state."
    },
    {
      "id": 2,
      "title": "PostgreSQL exporter connection and scrape error",
      "type": "timeseries",
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "{__name__=~\"pg_up|pg_exporter_last_scrape_error\",environment=\"$environment\",stack=\"deskseed\"}",
          "legendFormat": "{{__name__}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "No data — unavailable or no matching samples",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green"
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "description": "No data means telemetry is unavailable or no matching samples exist; it is not measured zero or a healthy state."
    },
    {
      "id": 3,
      "title": "Search class HTTP p95 (k6)",
      "type": "timeseries",
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "last_over_time(k6_agent_operation_duration_p95{environment=\"$environment\",test_run_id=~\"$run\",phase=\"measurement\",operation=\"agent_search\"}[1m])",
          "legendFormat": "{{test_run_id}} / {{query_class}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "noValue": "No data — unavailable or no matching samples",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green"
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "description": "Cumulative client trend summaries per run/class, held for up to 1 minute for short preflight visibility. Do not average percentiles or subtract client/server percentiles. No data means telemetry is unavailable or no matching samples exist; it is not measured zero or a healthy state."
    },
    {
      "id": 4,
      "title": "Search requests by class (k6)",
      "type": "timeseries",
      "gridPos": {
        "x": 12,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by(query_class) (rate(k6_agent_search_requests_total{environment=\"$environment\",test_run_id=~\"$run\",phase=\"measurement\"}[$__rate_interval]))",
          "legendFormat": "{{query_class}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "noValue": "No data — unavailable or no matching samples",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green"
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "description": "Counter rate requires at least two remote-write samples; a single-request preflight can legitimately show No data."
    },
    {
      "id": 5,
      "title": "JDBC count / page and audit phase p95",
      "type": "timeseries",
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95,sum by(le,phase,query_class)(rate(deskseed_search_phase_seconds_bucket{environment=\"$environment\",service=\"deskseed-backend\"}[$__rate_interval])))",
          "legendFormat": "{{phase}} / {{query_class}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "noValue": "No data — unavailable or no matching samples",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green"
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "description": "JDBC includes client round trip and row mapping. Audit includes protection/persistence calls but excludes transaction commit; HTTP span remains the end-to-end server boundary. Run selector filters client metrics only; server metrics require the same absolute time interval. No data means telemetry is unavailable or no matching samples exist; it is not measured zero or a healthy state."
    },
    {
      "id": 6,
      "title": "Phase errors",
      "type": "timeseries",
      "gridPos": {
        "x": 12,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by(phase,query_class)(rate(deskseed_search_phase_seconds_count{environment=\"$environment\",service=\"deskseed-backend\",outcome=\"error\"}[$__rate_interval]))",
          "legendFormat": "{{phase}} / {{query_class}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "noValue": "No data — unavailable or no matching samples",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green"
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "description": "No data means telemetry is unavailable or no matching samples exist; it is not measured zero or a healthy state."
    },
    {
