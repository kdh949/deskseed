      "description": "A restart/reset/eviction splits evidence windows; do not compare cumulative means across it. No data means telemetry is unavailable or no matching samples exist; it is not measured zero or a healthy state."
    },
    {
      "id": 21,
      "title": "Actual search arrival, active VUs and dropped iterations",
      "type": "timeseries",
      "description": "Actual completed search request rate, active VUs and scheduler drops for the selected k6 run. No data means remote-write samples are missing; zero drops must be a measured zero.",
      "gridPos": {
        "x": 0,
        "y": 72,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (test_run_id) (rate(k6_agent_search_requests_total{environment=\"$environment\",test_run_id=~\"$run\",phase=\"measurement\"}[$__rate_interval]))",
          "legendFormat": "{{test_run_id}} actual search/s"
        },
        {
          "refId": "B",
          "expr": "max by (test_run_id) (k6_vus{environment=\"$environment\",test_run_id=~\"$run\"})",
          "legendFormat": "{{test_run_id}} VUs"
        },
        {
          "refId": "C",
          "expr": "sum by (test_run_id) (increase(k6_dropped_iterations_total{environment=\"$environment\",test_run_id=~\"$run\"}[1m]))",
          "legendFormat": "{{test_run_id}} dropped/1m"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "No data — k6 remote write unavailable",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green"
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 22,
      "title": "HTTP, OVERALL, phase sum and mean unattributed time",
      "type": "timeseries",
      "description": "Mean wall-time decomposition at compatible rate/count grain. Unattributed = HTTP mean - COUNT/PAGE/AUDIT mean sum; it is a candidate bucket for filters, transaction commit, serialization and network, never a percentile subtraction or causal proof. No data means required histograms are missing.",
      "gridPos": {
        "x": 12,
        "y": 72,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(http_server_requests_seconds_sum{environment=\"$environment\",uri=\"/api/v1/agent/search\"}[$__rate_interval])) / clamp_min(sum(rate(http_server_requests_seconds_count{environment=\"$environment\",uri=\"/api/v1/agent/search\"}[$__rate_interval])), 0.000001)",
          "legendFormat": "HTTP mean"
        },
        {
          "refId": "B",
          "expr": "sum(rate(deskseed_search_phase_seconds_sum{environment=\"$environment\",phase=\"overall\"}[$__rate_interval])) / clamp_min(sum(rate(deskseed_search_phase_seconds_count{environment=\"$environment\",phase=\"overall\"}[$__rate_interval])), 0.000001)",
          "legendFormat": "OVERALL mean"
        },
        {
          "refId": "C",
          "expr": "sum(sum by (phase) (rate(deskseed_search_phase_seconds_sum{environment=\"$environment\",phase=~\"count|page|audit\"}[$__rate_interval])) / clamp_min(sum by (phase) (rate(deskseed_search_phase_seconds_count{environment=\"$environment\",phase=~\"count|page|audit\"}[$__rate_interval])), 0.000001))",
          "legendFormat": "COUNT+PAGE+AUDIT mean"
        },
        {
          "refId": "D",
          "expr": "clamp_min((sum(rate(http_server_requests_seconds_sum{environment=\"$environment\",uri=\"/api/v1/agent/search\"}[$__rate_interval])) / clamp_min(sum(rate(http_server_requests_seconds_count{environment=\"$environment\",uri=\"/api/v1/agent/search\"}[$__rate_interval])), 0.000001)) - sum(sum by (phase) (rate(deskseed_search_phase_seconds_sum{environment=\"$environment\",phase=~\"count|page|audit\"}[$__rate_interval])) / clamp_min(sum by (phase) (rate(deskseed_search_phase_seconds_count{environment=\"$environment\",phase=~\"count|page|audit\"}[$__rate_interval])), 0.000001)), 0)",
          "legendFormat": "unattributed mean"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "noValue": "No data — decomposition inputs missing",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green"
              },
              {
                "color": "yellow",
                "value": 0.5
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 23,
      "title": "Search traces — source location and profiles",
      "type": "table",
      "description": "TraceQL search results for the selected run. Open a trace to inspect service.version, code.file.path and code.function.name, then use Profiles for this span. No data means no matching sampled trace or unavailable Tempo ingest; it does not prove the request path was fast.",
      "gridPos": {
        "x": 0,
        "y": 80,
        "w": 12,
        "h": 10
      },
      "datasource": {
        "type": "tempo",
        "uid": "deskseed-search-tempo"
      },
      "targets": [
        {
          "refId": "A",
          "queryType": "traceql",
          "query": "{ resource.service.name = \"deskseed-backend\" && resource.deployment.environment.name = \"$environment\" && span.deskseed.search.phase != nil && span.deskseed.test_run_id =~ \"$run\" }"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "noValue": "No data — no sampled trace or Tempo unavailable",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green"
              },
              {
                "color": "yellow",
                "value": 0.5
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "id": 24,
      "title": "Queryid to protected plan artifact",
      "type": "table",
      "description": "Candidate queryids and phase only; query text is never exported. Select a queryid and follow the protected artifact index link. No data means no matching pg_stat_statements entry or unavailable DB scrape.",
      "gridPos": {
        "x": 12,
        "y": 80,
        "w": 12,
        "h": 10
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (phase, queryid) (increase(deskseed_search_sql_calls{environment=\"$environment\",stack=\"deskseed\"}[$__range]))",
          "format": "table",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "noValue": "No data — query statistics unavailable",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green"
              }
            ]
          },
          "links": [
            {
              "title": "Open plan artifact index for queryid",
              "url": "$plan_artifact_base?queryid=${__data.fields.queryid}",
              "targetBlank": true
            }
          ]
        },
        "overrides": []
      }
    },
    {
      "id": 25,
      "title": "Trace collector received / exported / failed",
      "type": "timeseries",
      "description": "Deskseed Alloy self-metrics. Received and exported should advance together; failed or refused above zero is a telemetry gap. No data means collector self-metrics are unavailable, not zero loss.",
      "gridPos": {
        "x": 0,
        "y": 90,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(otelcol_receiver_accepted_spans_total{job=\"deskseed-alloy\",receiver=~\".*deskseed.*\"}[$__rate_interval]))",
          "legendFormat": "received"
        },
        {
          "refId": "B",
          "expr": "sum(rate(otelcol_exporter_sent_spans_total{job=\"deskseed-alloy\"}[$__rate_interval]))",
          "legendFormat": "exported"
        },
        {
          "refId": "C",
          "expr": "sum(rate(otelcol_exporter_send_failed_spans_total{job=\"deskseed-alloy\"}[$__rate_interval]))",
          "legendFormat": "export failed"
        },
        {
          "refId": "D",
          "expr": "sum(rate(otelcol_receiver_refused_spans_total{job=\"deskseed-alloy\"}[$__rate_interval]))",
          "legendFormat": "receiver refused"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "noValue": "No data — collector self-metrics unavailable",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green"
              }
            ]
          }
        },
        "overrides": []
      }
    },
    {
