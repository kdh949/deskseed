global:
  scrape_interval: 15s
  evaluation_interval: 15s

rule_files:
  - /etc/prometheus/deskseed-personal-staging.rules.yml

scrape_configs:
  - job_name: deskseed-personal-staging-backend
    metrics_path: /actuator/prometheus
    static_configs:
      - targets: ["deskseed-personal-staging.internal:9090"]
        labels:
          environment: personal-staging
          service: deskseed-backend
          stack: deskseed

  - job_name: deskseed-personal-staging-alloy
    static_configs:
      - targets: ["deskseed-personal-staging.internal:12345"]
        labels:
          environment: personal-staging
          service: deskseed-alloy
          stack: deskseed
