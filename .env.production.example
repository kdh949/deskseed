# Copy to a mode-0600 file owned by the dedicated deployment account outside the repository.
DESKSEED_FRONTEND_BIND_ADDRESS=
DESKSEED_FRONTEND_ORIGIN_PORT=

POSTGRES_DB=deskseed
DATABASE_BOOTSTRAP_USERNAME=deskseed_bootstrap
DATABASE_BOOTSTRAP_PASSWORD=
DATABASE_MIGRATION_USERNAME=deskseed_migration
DATABASE_MIGRATION_PASSWORD=
DATABASE_RUNTIME_USERNAME=deskseed_runtime
DATABASE_RUNTIME_PASSWORD=

DESKSEED_REDIS_ACL_FILE=
DESKSEED_CUSTOMER_AUTH_REDIS_PASSWORD=
# Set true only after accepting the plaintext-on-private-Docker-network risk in docs/36.
DESKSEED_CUSTOMER_AUTH_REDIS_PLAINTEXT_INTERNAL_NETWORK_ACK=

DESKSEED_VERSITY_ACCESS_KEY=
DESKSEED_VERSITY_SECRET_KEY=
DESKSEED_ATTACHMENT_S3_REGION=us-east-1
DESKSEED_ATTACHMENT_S3_BUCKET=deskseed-attachments
DESKSEED_ATTACHMENT_MAX_UPLOAD_BYTES=20971520
# Five 20 MiB files plus bounded multipart form/header overhead.
DESKSEED_ATTACHMENT_MAX_REQUEST_BYTES=110100480
# Both must be true only after the Sophos/origin and internal-S3 risks in docs/36 are satisfied.
DESKSEED_ATTACHMENT_UPSTREAM_WAF_ACKNOWLEDGED=
DESKSEED_ATTACHMENT_S3_PLAINTEXT_INTERNAL_NETWORK_ACK=

DESKSEED_PLATFORM_ALLOWED_CLIENT_CIDRS=
DESKSEED_PLATFORM_TRUSTED_PROXY_CIDRS=
DESKSEED_WEBHOOK_SECRET_KEY_V1=
DESKSEED_MAIL_PROTECTED_KEY_V1=
DESKSEED_MAIL_OPERATIONS_CURSOR_SIGNING_KEY=
DESKSEED_CUSTOMER_AUTH_FINGERPRINT_KEY=
DESKSEED_CUSTOMER_AUTH_CSRF_KEY=
DESKSEED_CUSTOMER_AUTH_TRUSTED_PROXY_CIDRS=
DESKSEED_CUSTOMER_MAGIC_LINK_CONSUME_URL=
DESKSEED_CUSTOMER_REGISTRATION_VERIFICATION_URL=
DESKSEED_CUSTOMER_PASSWORD_RESET_URL=
DESKSEED_PUBLIC_REQUEST_RATE_LIMIT_FINGERPRINT_KEY=
DESKSEED_PUBLIC_REQUEST_RATE_LIMIT_TRUSTED_PROXY_CIDRS=
DESKSEED_CUSTOMER_CLAIM_SIGNING_KEY=
DESKSEED_CUSTOMER_CLAIM_FINGERPRINT_KEY=
DESKSEED_CUSTOMER_REQUEST_CURSOR_SIGNING_KEY=
DESKSEED_ACCESS_AUDIT_SESSION_FINGERPRINT_KEY=
DESKSEED_ACCESS_AUDIT_KEY_V1=
DESKSEED_AUDIT_CURSOR_SIGNING_KEY=
DESKSEED_CORS_ALLOWED_ORIGINS=
DESKSEED_AGENT_TICKET_CURSOR_SIGNING_KEY=

DESKSEED_BOOTSTRAP_ADMIN_ENABLED=false
DESKSEED_BOOTSTRAP_ADMIN_EMAIL=
DESKSEED_BOOTSTRAP_ADMIN_DISPLAY_NAME=
DESKSEED_BOOTSTRAP_ADMIN_PASSWORD_FILE=/dev/null
