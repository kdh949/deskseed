POSTGRES_DB=deskseed
POSTGRES_USER=deskseed
POSTGRES_PASSWORD=deskseed-local-only
DATABASE_URL=jdbc:postgresql://db:5432/deskseed
DATABASE_USERNAME=deskseed
DATABASE_PASSWORD=deskseed-local-only
DESKSEED_CORS_ALLOWED_ORIGINS=http://localhost:5173
DESKSEED_MAILPIT_PORT=8025
DESKSEED_MAIL_FROM_ADDRESS=no-reply@deskseed.local
DESKSEED_MAIL_PUBLIC_BASE_URL=http://localhost:5173

# Blank signing keys use the public local-development defaults from compose.yaml.
# A production manifest must instead provision independent secrets outside version control.
DESKSEED_AGENT_TICKET_CURSOR_ACTIVE_KEY_ID=v1
DESKSEED_AGENT_TICKET_CURSOR_SIGNING_KEY=
DESKSEED_AUDIT_CURSOR_ACTIVE_KEY_ID=v1
DESKSEED_AUDIT_CURSOR_SIGNING_KEY=

# The local-v1 key is an intentionally public development value. Production must
# switch to its own version and exactly 32 random bytes encoded as base64.
DESKSEED_ACCESS_AUDIT_ENABLED=true
DESKSEED_ACCESS_AUDIT_ACTIVE_KEY_VERSION=local-v1
DESKSEED_ACCESS_AUDIT_KEY_LOCAL_V1=AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=
# Independent 32-byte base64 key. Never rotate it with raw-query encryption keys.
DESKSEED_ACCESS_AUDIT_SESSION_FINGERPRINT_KEY=AQEBAQEBAQEBAQEBAQEBAQEBAQEBAQEBAQEBAQEBAQE=
# Keep production key material in an external secret manager and retain old keys during rotation.
DESKSEED_ACCESS_AUDIT_KEY_V1=
DESKSEED_ACCESS_AUDIT_QUERY_CIPHERTEXT_RETENTION=30d
DESKSEED_ACCESS_AUDIT_RETENTION_BATCH_SIZE=1000
DESKSEED_ACCESS_AUDIT_RETENTION_JOB_INTERVAL=1h
DESKSEED_ACCESS_AUDIT_RETENTION_JOB_INITIAL_DELAY=10m

# First boot only. The password file must remain outside this repository.
DESKSEED_BOOTSTRAP_ADMIN_ENABLED=false
DESKSEED_BOOTSTRAP_ADMIN_EMAIL=
DESKSEED_BOOTSTRAP_ADMIN_DISPLAY_NAME=
# DESKSEED_BOOTSTRAP_ADMIN_PASSWORD_FILE=/absolute/path/outside-repository/deskseed-first-admin.secret
# File-backed Compose secrets keep host mode/ownership. During bootstrap set:
# DESKSEED_RUNTIME_USER=1000:1000
