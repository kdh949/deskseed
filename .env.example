POSTGRES_DB=deskseed
POSTGRES_USER=deskseed
POSTGRES_PASSWORD=deskseed-local-only
DATABASE_URL=jdbc:postgresql://db:5432/deskseed
DATABASE_USERNAME=deskseed
DATABASE_PASSWORD=deskseed-local-only
DESKSEED_CORS_ALLOWED_ORIGINS=http://localhost:5173

# Required in the production profile. Generate at least 32 random bytes and keep the value outside version control.
DESKSEED_AGENT_TICKET_CURSOR_ACTIVE_KEY_ID=v1
DESKSEED_AGENT_TICKET_CURSOR_SIGNING_KEY=

# First boot only. The password file must remain outside this repository.
DESKSEED_BOOTSTRAP_ADMIN_ENABLED=false
DESKSEED_BOOTSTRAP_ADMIN_EMAIL=
DESKSEED_BOOTSTRAP_ADMIN_DISPLAY_NAME=
# DESKSEED_BOOTSTRAP_ADMIN_PASSWORD_FILE=/absolute/path/outside-repository/deskseed-first-admin.secret
